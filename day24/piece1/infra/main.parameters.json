{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "containerCpu": {
      "value": "${CONTAINER_CPU}"
    },
    "containerMemory": {
      "value": "${CONTAINER_MEMORY}"
    },
    "minReplicas": {
      "value": "${MIN_REPLICAS}"
    },
    "maxReplicas": {
      "value": "${MAX_REPLICAS}"
    },
    "sqlSkuCapacity": {
      "value": "${SQL_SKU_CAPACITY}"
    },
    "sqlMinCapacity": {
      "value": "${SQL_MIN_CAPACITY}"
    },
    "sqlAutoPauseDelayMinutes": {
      "value": "${SQL_AUTOPAUSE_MINUTES}"
    },
    "serviceBusZoneRedundant": {
      "value": "${SERVICEBUS_ZONE_REDUNDANT}"
    },
    "sqlAdministratorLoginPassword": {
      "value": "${SQL_ADMIN_PASSWORD}"
    }
  }
}
