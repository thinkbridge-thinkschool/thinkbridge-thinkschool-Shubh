<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Same rule as every other module: only Api/NotificationsModule.cs is public. Notice this
    project references Shared only — NOT Quotes. It learns about a created quote solely
    through QuoteCreatedIntegrationEvent (Shared.Contracts.Quotes); it has no way to reach
    the Quote aggregate, QuotesDbContext, or any other Quotes-internal type even if it
    wanted to.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Shared.csproj" />
  </ItemGroup>

</Project>
