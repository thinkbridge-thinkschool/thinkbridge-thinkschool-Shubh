<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QuotesApi.Shared.Migrations.SqlServer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Day 29: the Azure SQL migration history for QuotesDbContext lives in its own
         assembly/MigrationsAssembly (see SharedModuleExtensions.AddSharedInfrastructure),
         deliberately separate from the pre-existing SQLite migrations under
         Shared/Infrastructure/Persistence/Migrations. EF Core allows only one ModelSnapshot
         per (DbContext, assembly) pair, so two providers' migration histories cannot coexist
         in the same assembly — this project exists so the original SQLite migrations stay
         completely untouched (not deleted, not rewritten) while Azure SQL gets its own,
         independent history. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\QuotesApi.Shared.csproj" />
  </ItemGroup>

</Project>
