<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Day 30: its own secrets scope, deliberately different from Day 29's — this copy
         must never read or write Day 29's local secrets (Jwt:Key, local SQL connection). -->
    <UserSecretsId>2b9c33a6-3b24-49f5-9c89-cd592968c8f5</UserSecretsId>
    <!-- Keeps the published assembly named QuotesApi.dll so the existing Dockerfile
         ENTRYPOINT and azd deployment wiring keep working unchanged. -->
    <AssemblyName>QuotesApi</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- dotnet-ef requires the startup project itself to reference Design (Shared and the
         migrations project both mark it PrivateAssets="all", so it doesn't flow here). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.17.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Host is the only project every module and Shared may be referenced from — the one
         deployable process this modular monolith assembles into. -->
    <ProjectReference Include="..\Modules\Quotes\QuotesApi.Modules.Quotes.csproj" />
    <ProjectReference Include="..\Modules\Identity\QuotesApi.Modules.Identity.csproj" />
    <ProjectReference Include="..\Modules\Notifications\QuotesApi.Modules.Notifications.csproj" />
    <ProjectReference Include="..\Shared\QuotesApi.Shared.csproj" />
    <!-- Day 29: the Azure SQL migrations assembly (see SharedModuleExtensions' MigrationsAssembly
         config) must be part of the running app so Database.Migrate() can find it. -->
    <ProjectReference Include="..\Shared.Migrations.SqlServer\QuotesApi.Shared.Migrations.SqlServer.csproj" />
  </ItemGroup>

</Project>
