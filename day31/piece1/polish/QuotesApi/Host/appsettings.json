{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Debug",
      "QuotesApi": "Information"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Debug",
        "QuotesApi": "Information"
      }
    },

    "Enrich": [
      "FromLogContext"
    ],

    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [TraceId: {TraceId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "QuotesApi",
    "Audience": "QuotesApiClient",
    "ExpiresInMinutes": 15
  },

  "Entra": {
    "TenantId": "be69d82d-4ebe-474d-9ac7-00efbf13427e",
    "ClientId": "1690071e-459f-4aef-99ff-33713b900858",
    "Audience": "api://1690071e-459f-4aef-99ff-33713b900858"
  },

  "// Sql": "Azure SQL, Entra-ID/Managed Identity auth only — no password here or anywhere else. Dedicated Day 29 database on the shared Day 25 server; Day 25's own identitydb is never targeted.",
  "Sql": {
    "Server": "sql-day25-shubh2026.database.windows.net",
    "Database": "quotesapi-day29"
  },

  "ServiceBus": {
    "Namespace": "sb-day19-quotedemo.servicebus.windows.net",
    "Topic": "quote-events",
    "Notifications": {
      "SubscriptionName": "notifications",
      "MaxConcurrentCalls": 4
    }
  },

  "Outbox": {
    "PollingIntervalSeconds": 5,
    "BatchSize": 20
  },

  "DemoDependency": {
    "BaseUrl": "http://localhost:5177"
  }
}